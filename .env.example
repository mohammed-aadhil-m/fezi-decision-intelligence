# ====================================================================
# FEZI AI DECISION INTELLIGENCE — ENVIRONMENT CONFIGURATION
# ====================================================================

# Port for local development / custom deployment
PORT=3000
NODE_ENV=production

# Database (PostgreSQL Connection String)
# Example: postgres://fezi_user:password@localhost:5432/fezi
DATABASE_URL=

# Authentication & Security
SESSION_SECRET=your-random-32-char-session-secret-here
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars-long

# AI Provider Integration (Structured claim extraction and narrative synthesis)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Live Research Search Provider (e.g. Tavily / SerpApi / Brave)
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily

# Service URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
